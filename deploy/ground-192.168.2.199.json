{
  "_comment": "RK3566 ground decoder validation: RTL8812CU monitor-mode receiver with frame-SHM egress. Originator 10 keeps the x86 ground (9) authoritative.",
  "node": {
    "originator": 10,
    "role": "rx",
    "preferred_originator": 17,
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.example.json",
  "adapters": [
    {
      "name": "cu-rk-ground",
      "ifname": "wlx40a5ef2f229b",
      "role": "tx",
      "channel": 5805,
      "bw": 20
    }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "out",
      "originator": 17,
      "bind": {
        "kind": "frame-shm",
        "name": "venc_frame_out"
      }
    }
  ],
  "air": {
    "kind": "kernel-monitor"
  },
  "policy": {
    "return": {
      "quiet_gap": true,
      "guard_us": 300,
      "return_window_us": 2000
    }
  },
  "control": {
    "bind": "127.0.0.1:8092"
  },
  "stats": {
    "hz": 1
  }
}
