{
  "_comment": "Mirrors /etc/waybeam-link/ground.json on the ground at 192.168.2.242, read from the node 2026-08-08. Devourer (air.kind radio). The 8812EU uplink is temporarily disconnected, so the 8812AU on bus 8-1 is the uplink and the 8812CU on 5-1 is RX diversity. The cache.repair stanza this file used to carry pointed at a .247 cache the running node does not configure.",
  "node": {
    "originator": 9,
    "role": "rx",
    "preferred_originator": 17,
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.example.json",
  "adapters": [
    {
      "name": "au-uplink",
      "role": "tx",
      "channel": 5805,
      "bw": 20,
      "max_power_qdb": 108,
      "power_presets_qdb": [
        60,
        76,
        84,
        92,
        108
      ],
      "bus": "8-1",
      "calib_id": "ground-au-1",
      "power_offset_presets_qdb": [
        -72,
        -48,
        -24,
        0,
        24
      ],
      "power_offset_max_qdb": 24
    },
    {
      "name": "cu-diversity",
      "role": "rx",
      "channel": 5805,
      "bw": 20,
      "bus": "5-1"
    }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "out",
      "originator": 17,
      "bind": {
        "kind": "frame-shm",
        "name": "venc_frame_out"
      }
    },
    {
      "stream_id": 1,
      "stream_type": "AUDIO",
      "dir": "out",
      "bind": {
        "kind": "udp",
        "send": "127.0.0.1:5601"
      }
    }
  ],
  "air": {
    "kind": "radio"
  },
  "policy": {
    "return": {
      "quiet_gap": true,
      "guard_us": 300,
      "return_window_us": 2000
    },
    "csa": {
      "home_chan": 5805,
      "channel_allowlist": [
        5180,
        5220,
        5745,
        5765,
        5785,
        5805,
        5825
      ]
    },
    "calibration": {
      "offset_seek_step_qdb": 2
    }
  },
  "scout": {
    "dwell_ms": 300,
    "channels": [
      5180,
      5220,
      5745,
      5765,
      5785,
      5805,
      5825
    ]
  },
  "control": {
    "bind": "127.0.0.1:8092"
  },
  "stats": {
    "hz": 10,
    "stdout": false
  }
}
