{
  "_comment": "Mirrors /etc/waybeam-link/ground.json on the ground at 192.168.2.242, read from the node 2026-08-09. SINGLE 8812AU on bus 5-1 as the TX/RX combo (operator rule) - RadioAir's role:'tx' adapter is duplex and also receives, so no second adapter is paired for the ground role; the 8812CU diversity entry this file used to carry is gone. Bus was 8-1 in the previous revision and nothing is there now: USB bus paths shuffle on re-plug, so the path is measured (lsusb -t), never carried over. Devourer (air.kind radio); whole-frame SHM egress.",
  "node": {
    "originator": 9,
    "role": "rx",
    "preferred_originator": 17,
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.example.json",
  "adapters": [
    {
      "name": "au-uplink",
      "role": "tx",
      "channel": 5805,
      "bw": 20,
      "max_power_qdb": 108,
      "power_presets_qdb": [
        60,
        76,
        84,
        92,
        108
      ],
      "bus": "5-1",
      "calib_id": "ground-au-1",
      "power_offset_presets_qdb": [
        -72,
        -48,
        -24,
        0,
        24
      ],
      "power_offset_max_qdb": 24
    }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "out",
      "originator": 17,
      "bind": {
        "kind": "frame-shm",
        "name": "venc_frame_out"
      }
    },
    {
      "stream_id": 1,
      "stream_type": "AUDIO",
      "dir": "out",
      "bind": {
        "kind": "udp",
        "send": "127.0.0.1:5601"
      }
    },
    {
      "_comment": "§7.5 uplink RC ingress — hub telemetry.udp_target points here",
      "stream_id": 2,
      "stream_type": "CONTROL",
      "dir": "in",
      "bind": {
        "kind": "udp",
        "listen": "127.0.0.1:14650"
      }
    },
    {
      "_comment": "downlink FC telemetry delivery — into the ground hub's UDP bind",
      "stream_id": 3,
      "stream_type": "TELEMETRY",
      "dir": "out",
      "bind": {
        "kind": "udp",
        "send": "127.0.0.1:14550"
      }
    }
  ],
  "air": {
    "kind": "radio"
  },
  "policy": {
    "return": {
      "quiet_gap": true,
      "guard_us": 300,
      "return_window_us": 2000
    },
    "csa": {
      "home_chan": 5805,
      "channel_allowlist": [
        5180,
        5200,
        5220,
        5240,
        5260,
        5280,
        5300,
        5320,
        5500,
        5520,
        5540,
        5560,
        5580,
        5600,
        5620,
        5640,
        5660,
        5680,
        5700,
        5720,
        5745,
        5765,
        5785,
        5805,
        5825
      ]
    },
    "calibration": {
      "offset_seek_step_qdb": 2
    }
  },
  "scout": {
    "dwell_ms": 300,
    "channels": [
      5180,
      5200,
      5220,
      5240,
      5260,
      5280,
      5300,
      5320,
      5500,
      5520,
      5540,
      5560,
      5580,
      5600,
      5620,
      5640,
      5660,
      5680,
      5700,
      5720,
      5745,
      5765,
      5785,
      5805,
      5825
    ]
  },
  "control": {
    "bind": "127.0.0.1:8092"
  },
  "stats": {
    "hz": 10,
    "stdout": false
  }
}
