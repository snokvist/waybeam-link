{
  "_comment": "Ground: RTL8812EU return uplink plus RTL8812CU receive diversity; whole-frame SHM egress and Ethernet cache repair.",
  "node": {
    "originator": 9,
    "role": "rx",
    "preferred_originator": 17,
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.example.json",
  "adapters": [
    {
      "name": "eu-uplink",
      "ifname": "wlx84fc1450bcde",
      "role": "tx",
      "channel": 5805,
      "bw": 20
    },
    {
      "name": "cu-diversity",
      "ifname": "wlx40a5ef2f2308",
      "role": "rx",
      "channel": 5805,
      "bw": 20
    }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "out",
      "originator": 17,
      "bind": {
        "kind": "frame-shm",
        "name": "venc_frame_out"
      }
    },
    {
      "stream_id": 1,
      "stream_type": "AUDIO",
      "dir": "out",
      "bind": {
        "kind": "udp",
        "send": "127.0.0.1:5601"
      }
    }
  ],
  "air": {
    "kind": "kernel-monitor"
  },
  "policy": {
    "return": {
      "quiet_gap": true,
      "guard_us": 300,
      "return_window_us": 2000
    },
    "csa": {
      "home_chan": 5805,
      "channel_allowlist": [5180, 5220, 5745, 5765, 5785, 5805, 5825]
    }
  },
  "scout": {
    "dwell_ms": 300,
    "channels": [5180, 5220, 5745, 5765, 5785, 5805, 5825]
  },
  "cache": {
    "repair": {
      "enabled": true,
      "stream_id": 0,
      "listen": "192.168.2.242:5802",
      "caches": [
        {
          "originator": 33,
          "endpoint": "192.168.2.247:5801"
        }
      ],
      "tail_grace_ms": 1,
      "local_quiet_ms": 2,
      "min_collect_ms": 4,
      "hard_close_ms": 8,
      "request_timeout_ms": 4,
      "nack_grace_ms": 3,
      "repair_fraction_permille": 200,
      "absolute_symbol_limit": 8,
      "max_cache_attempts": 2,
      "reply_limit": 4,
      "health_floor_permille": 800,
      "status_timeout_ms": 1500,
      "assignment_interval_ms": 500
    }
  },
  "control": {
    "bind": "127.0.0.1:8092"
  },
  "stats": {
    "hz": 5
  }
}
