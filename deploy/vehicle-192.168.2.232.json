{
  "_comment": "Vehicle: RTL8812EU kernel-monitor TX/RX on 5805/HT20; adaptive MCS1-5 with venc-owned bitrate follow (§9.6), 30% IDR / 20% P-frame RLC, FPS_SELECT {30,60,90,100} over a 100fps base.",
  "node": {
    "originator": 17,
    "role": "tx",
    "preferred_originator": 9,
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.example.json",
  "adapters": [
    {
      "name": "eu-craft",
      "ifname": "wlan0",
      "role": "tx",
      "channel": 5805,
      "bw": 20
    }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "in",
      "bind": {
        "kind": "frame-shm",
        "name": "venc_frame"
      },
      "arq_mode": "idr-only",
      "fec": {
        "scheme": "rlc256",
        "i_rate_permille": 300,
        "p_rate_permille": 200,
        "min_k": 3
      }
    }
  ],
  "air": {
    "kind": "kernel-monitor"
  },
  "policy": {
    "report_timeout_ms": 750,
    "select": {
      "min_profile": 1,
      "max_profile": 5
    },
    "return": {
      "quiet_gap": true,
      "guard_us": 300,
      "return_window_us": 2000
    },
    "csa": {
      "home_chan": 5805,
      "channel_allowlist": [5180, 5220, 5745, 5765, 5785, 5805, 5825]
    }
  },
  "venc": {
    "host": "127.0.0.1:80",
    "enabled": true,
    "recovery_enabled": true,
    "max_bitrate_kbps": 25000,
    "command_presets": { "fps": [30, 60, 90, 100] }
  },
  "control": {
    "bind": "127.0.0.1:8091"
  },
  "stats": {
    "hz": 1
  }
}
