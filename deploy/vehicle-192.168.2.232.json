{
  "_comment": "Mirrors /etc/waybeam-link/craft.json on the vehicle at 192.168.2.232, read from the node 2026-08-08. Devourer (air.kind radio) since 2026-08-06; the kernel-monitor shape this file used to carry was stale.",
  "node": {
    "originator": 17,
    "role": "tx",
    "preferred_originator": 0,
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.example.json",
  "adapters": [
    {
      "name": "eu-craft",
      "role": "tx",
      "channel": 5805,
      "bw": 20,
      "max_power_qdb": 108,
      "power_presets_qdb": [
        60,
        76,
        84,
        92,
        108
      ],
      "bus": "1-1",
      "calib_id": "craft-eu-1",
      "power_offset_max_qdb": 24
    }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "in",
      "bind": {
        "kind": "frame-shm",
        "name": "venc_frame"
      },
      "arq_mode": "idr-only",
      "fec": {
        "scheme": "rlc256",
        "i_rate_permille": 300,
        "p_rate_permille": 200,
        "min_k": 3
      }
    },
    {
      "stream_id": 1,
      "stream_type": "AUDIO",
      "dir": "in",
      "bind": {
        "kind": "udp",
        "listen": "127.0.0.1:5601"
      }
    }
  ],
  "air": {
    "kind": "radio"
  },
  "policy": {
    "report_timeout_ms": 750,
    "select": {
      "min_profile": 2,
      "max_profile": 5,
      "demote_milli": 45
    },
    "return": {
      "quiet_gap": true,
      "guard_us": 300,
      "return_window_us": 2000
    },
    "csa": {
      "home_chan": 5805,
      "channel_allowlist": [
        5180,
        5220,
        5745,
        5765,
        5785,
        5805,
        5825
      ],
      "verify_timeout_ms": 600,
      "rx_liveness_ms": 4000
    },
    "calibration": {
      "offset_seek_step_qdb": 2
    }
  },
  "venc": {
    "host": "127.0.0.1:80",
    "enabled": true,
    "recovery_enabled": true,
    "max_bitrate_kbps": 25000,
    "command_presets": {
      "fps": [
        30,
        60,
        90,
        100
      ]
    },
    "mode_apply_cmd": "/etc/waybeam-link/modes/apply-mode.sh",
    "active_mode": "imx335-60fps-lowrange",
    "fps_ladder": {
      "enabled": false,
      "min": 30,
      "preferred": 100,
      "max": 144,
      "min_p_frame_bytes": 10000,
      "restore_hysteresis_bytes": 1000,
      "sample_timeout_ms": 500,
      "reduce_after_ms": 3000,
      "reduce_dwell_ms": 4000,
      "restore_after_ms": 8000,
      "settle_ms": 1500
    }
  },
  "control": {
    "bind": "127.0.0.1:8091"
  },
  "stats": {
    "hz": 10,
    "stdout": false
  }
}
