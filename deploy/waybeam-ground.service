[Unit]
Description=Waybeam FPV ground receiver
Wants=network-online.target
After=network-online.target
ConditionPathExists=/sys/class/net/wlx84fc1450bcde
ConditionPathExists=/sys/class/net/wlx40a5ef2f2308

[Service]
Type=simple
User=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/sbin/rfkill unblock wifi
ExecStartPre=/usr/local/libexec/waybeam-mon-up wlx84fc1450bcde 161 HT20
ExecStartPre=/usr/local/libexec/waybeam-mon-up wlx40a5ef2f2308 161 HT20
ExecStart=/usr/local/bin/waybeam-link rx -c /etc/waybeam-link/ground.json
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
